PORT=3090
STATUS_INGEST_KEY=dev-shared-secret
# Warn when no report received within this window (ms)
STALE_AFTER_MS=900000
# Comma-separated service ids that should always appear on the dashboard
EXPECTED_SERVICES=care.theodi.org,service-status
# How often this collector reports on itself
SELF_REPORT_INTERVAL_MS=300000
# Optional path for last-report persistence (defaults to ./data/reports.json)
# REPORTS_STORE_PATH=./data/reports.json
# Allowlist settings (defaults to ./data/settings.json) — edit via /configure UI
# SETTINGS_STORE_PATH=./data/settings.json
# Set to 1 when behind a reverse proxy so ingest IP uses X-Forwarded-For
# TRUST_PROXY=1

# Dashboard auth (Google only — @theodi.org staff)
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3090/auth/google/callback
# Optional: canonical public origin for the configure panel (no trailing slash)
# PUBLIC_BASE_URL=https://status.example.theodi.org
